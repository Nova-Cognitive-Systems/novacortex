# ============================================
# NovaCortex — Unraid environment
# ============================================
# Every variable docker-compose.unraid.yml reads, with the defaults it applies.
#
# Do not hand-write the secrets. Generate this file instead, with --unraid so the
# data root lands on the array rather than next to the compose file:
#   ./scripts/gen-env.sh --unraid                     # hosted or no embeddings
#   ./scripts/gen-env.sh --unraid --local-embeddings  # offline semantic search (Ollama)
#   ./scripts/gen-env.sh --unraid --local-ai          # offline search + intelligence
# then put it next to docker-compose.yml in the Compose Manager project directory
# (/boot/config/plugins/compose.manager/projects/novacortex/).
#
# There is no admin password to set here: the API prints a one-time bootstrap code
# on first start ("docker logs novacortex-api 2>&1 | grep -A1 'Bootstrap code'"),
# which you exchange for an admin token on the Web UI login page.
# ============================================

# ── Host ports — CHECK THESE BEFORE "COMPOSE UP" ─────────
# Compose fails to start if either port is already bound on the server. 3000 is a
# popular default (Grafana, Homepage, Overseerr, …), so it is frequently taken;
# WEB_PORT=3100 is a safe alternative. Only the host side changes — the Web UI
# still talks to the API over the internal Docker network either way, and the
# Community Apps WebUI link follows whatever host port you set.
#   Check first:  ss -ltnp | grep -E ':(3000|3001)\b'
WEB_PORT=3000
API_PORT=3001

# ── Data root — MUST be an absolute path on the array/pool ─────────
# Bind-mount root for SurrealDB, Qdrant and Redis. Keeping it under
# /mnt/user/appdata means the data survives docker.img rebuilds and is picked up
# by the Unraid appdata backup plugin.
#
# Never use a relative path here on Unraid. Compose Manager keeps its projects on
# the FAT32 boot flash, which has no Unix ownership, so a relative APPDATA puts
# Redis' AOF and SurrealDB's RocksDB store on the USB stick — where Redis cannot
# take ownership of its data directory and restart-loops as unhealthy.
APPDATA=/mnt/user/appdata/novacortex

# ── Required secrets ─────────────────────────
# The stack refuses to start without these. Generate with: openssl rand -hex 24
SURREALDB_USER=root
SURREALDB_PASS=change-me-surrealdb-password
REDIS_PASSWORD=change-me-redis-password

# ── Image version ────────────────────────────
# The known-good release tag on GHCR. Keep api and web on the same version.
NOVACORTEX_VERSION=1.3.2

# ── SurrealDB ────────────────────────────────
SURREALDB_NAMESPACE=novacortex
SURREALDB_DATABASE=production

# ── Qdrant ───────────────────────────────────
# Leave the key blank to disable Qdrant auth (fine on a LAN-only stack).
QDRANT_API_KEY=
QDRANT_COLLECTION=
# Must match the embedding model's dimension: 1536 for text-embedding-3-small,
# 768 for nomic-embed-text. Changing it needs a fresh Qdrant collection, and a
# mismatch fails API startup loudly rather than silently storing nothing.
QDRANT_VECTOR_SIZE=1536

# ── Semantic search (optional) ───────────────
# Unset = substring-only search. /health reports the active mode.
#
# Fully offline via the bundled Ollama sidecar — no memory text leaves the server.
# Start the stack with: docker compose --profile local-ai up -d
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# QDRANT_VECTOR_SIZE=768
# OLLAMA_PULL=nomic-embed-text
#
# Hosted instead: memory text is sent to OpenAI (or whatever OPENAI_BASE_URL points at).
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# ── Memory intelligence (optional) ───────────
# LLM fact extraction + append-only conflict resolution. Any OpenAI-compatible
# endpoint; LLM_* falls back to the OPENAI_* pair when unset. Unset = off.
# LLM_MODEL=qwen3:8b
# OLLAMA_PULL=nomic-embed-text qwen3:8b

# ── Hardening (optional) ─────────────────────
# Lock the API's CORS to your Web UI origin(s), comma-separated. Unset = permissive.
# The port here must match WEB_PORT above.
# CORS_ORIGINS=http://192.168.1.100:3000
# Requests/min across data-plane routes. Unset = the license tier's limit; 0/off disables.
# API_RATE_LIMIT=
LOG_LEVEL=info

# ── License (optional) ───────────────────────
# Empty = free tier (3 namespaces). It needs no key and no account.
LICENSE_KEY=
